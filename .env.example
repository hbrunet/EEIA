# Por defecto apunta al servidor en Render (configurado en eas.json).
# Para probar con servidor local, creá un archivo .env.local con tu IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
EXPO_PUBLIC_API_BASE_URL=https://eeia.onrender.com
SERVER_PORT=3000
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_CONTEXT_WINDOW=8
